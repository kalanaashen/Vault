<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="PasswordWallet.Views.ConfirmationWindow"
    Width="400"
    Height="220"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Title="Confirmation">

    <Border
        Background="#111827"
        CornerRadius="12"
        Padding="25">

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Title -->
            <TextBlock
                Grid.Row="0"
                Text="Confirm Action"
                FontSize="22"
                FontWeight="Bold"
                Foreground="White"
                HorizontalAlignment="Center"/>

            <!-- Message -->
            <TextBlock
                x:Name="MessageTextBlock"
                Grid.Row="1"
                Text="Are you sure?"
                FontSize="15"
                Foreground="#D1D5DB"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center"/>

            <!-- Buttons -->
            <StackPanel
                Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="12">

                <Button
                    Content="Cancel"
                    Width="100"
                    CornerRadius="6"
                    Background="#6B7280"
                    Foreground="White"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="CancelButton_Click"/>

                <Button
                    Content="Confirm"
                    Width="100"
                    Background="#DC2626"
                    Foreground="White"
                    CornerRadius="6"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="ConfirmButton_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>